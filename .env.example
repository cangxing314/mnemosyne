# 把这个文件复制一份，命名为 .env，然后把 key 填在等号后面
# 不要加引号、不要加空格；.env 已被 .gitignore 忽略，不会提交到 GitHub
#
# 必填两个 key，作用与申请地址见下方


# ── 必填 1：大脑模型（NPC 本体）───────────────────────────────
# DeepSeek 开放平台 https://platform.deepseek.com/
# 默认用 deepseek-flash 当 NPC 大脑。想换别家也行——见文件末尾的"进阶"。
DEEPSEEK_API_KEY=


# ── 必填 2：向量化（记忆检索的地基）────────────────────────────
# 阿里云百炼 https://bailian.console.aliyun.com/
# embedding 模型固定 text-embedding-v3，代码里写死了这条通道。
# 不填的话 bootstrap 初始化会失败——记忆层是项目的核心依赖。
#
# 同一条 key 还兼两用（所以评测那套也认它）：
#   · LLM Judge 裁判模型 qwen-plus（scripts/judge.py）
#   · 跨模型 sweep 的网关（scripts/sweep.py，托管 glm / kimi / deepseek 第三方模型）
DASHSCOPE_API_KEY=


# ── 可选：仅连通性自检脚本用（主流程不需要）─────────────────────
# 智谱开放平台 https://open.bigmodel.cn/
# 只有 scripts/ping_models.py 和 scripts/ping_toolcall.py 读它（早期连通性探针）。
# 不跑这两个脚本就不用填。
ZHIPU_API_KEY=


# ─────────────────────────────────────────────────────────────
# 进阶：换掉 NPC 的"大脑"模型（embedding 不可换）
# 下面三个变量不设时，默认值 = deepseek-flash + api.deepseek.com + DEEPSEEK_API_KEY，
# 即完全按上面的第 1 组跑。想用别家 OpenAI 兼容端点当大脑，就设这三个：
#
# MNEMOSYNE_MODEL=gpt-4o-mini
# MNEMOSYNE_BASE_URL=https://your-endpoint.example.com/v1
# MNEMOSYNE_API_KEY=sk-xxxx
#
# 这些是**进程启动时**读一次的，改完要重启服务才生效。
